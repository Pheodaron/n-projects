APP_IMAGE=n-projects:local
POSTGRES_PASSWORD=dev
DATABASE_URL=postgres://nprojects:dev@postgres:5432/nprojects?sslmode=disable
DEV_TOKEN=replace-with-a-random-local-development-token
BACKEND_BIND=127.0.0.1
BACKEND_PORT=8080
# Wails client connects from the host to this address:
BACKEND_URL=http://127.0.0.1:8080
# In a container localhost points to the container itself. Set a reachable service address.
LLAMA_BASE_URL=http://your-inference-host:8081/v1
LLAMA_MODEL=your-model-id
LLAMA_API_KEY=
