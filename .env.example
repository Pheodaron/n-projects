# Готовый Docker-образ backend; по умолчанию n-projects:local.
APP_IMAGE=n-projects:local
# Пароль PostgreSQL; должен совпадать в обеих строках подключения.
POSTGRES_PASSWORD=dev
# Порт PostgreSQL на хосте: 1–65535; по умолчанию 5432.
POSTGRES_PORT=5432
# Goose: подключение с хоста через опубликованный порт PostgreSQL.
DATABASE_URL=postgres://nprojects:dev@127.0.0.1:5432/nprojects?sslmode=disable
# Backend: подключение из контейнера через имя сервиса postgres.
BACKEND_DATABASE_URL=postgres://nprojects:dev@postgres:5432/nprojects?sslmode=disable
# Обязательный токен backend; default desktop — dev-token, другой передаётся клиенту через --token.
DEV_TOKEN=dev-token
# IP публикации backend: 127.0.0.1 — только хост, 0.0.0.0 — все IPv4-интерфейсы.
BACKEND_BIND=127.0.0.1
# Порт backend на хосте: 1–65535; по умолчанию 8080.
BACKEND_PORT=8080
# Обязательный URL llama.cpp с /v1, доступный из контейнера; localhost — сам контейнер.
LLAMA_BASE_URL=http://your-inference-host:8081/v1
# Обязательный точный model ID из /v1/models вашего inference-сервиса.
LLAMA_MODEL=your-model-id
# Необязательный bearer token inference-сервиса; пустое значение — без авторизации.
LLAMA_API_KEY=

# Необязательный URL PostgreSQL с машины запуска тестов; без него DB-тесты пропускаются.
# TEST_DATABASE_URL=postgres://nprojects:dev@127.0.0.1:5432/nprojects?sslmode=disable
