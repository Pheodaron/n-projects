# Пароль роли agentcore. Задайте значение в локальном .env перед первым запуском.
PGPASSWORD=''

# IPv4-адрес интерфейса сервера. Для прямого доступа desktop укажите IP сервера в LAN/VPN.
PG_BIND_ADDRESS=127.0.0.1

# Порт на хосте для Compose и Goose. PostgreSQL в контейнере слушает 5432.
PGPORT=5432

# При публикации на LAN/VPN-интерфейсе укажите для Goose доступное имя БД.
# Для verify-full настройте TLS на сервере и доверенный корневой сертификат у клиента.
# GOOSE_DBSTRING='postgres://agentcore@db.example.org:5432/agentcore?sslmode=verify-full'
