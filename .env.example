APP_IMAGE=n-projects:local
POSTGRES_PASSWORD=dev
POSTGRES_PORT=5432
# Goose connects from the project root through the published host port:
DATABASE_URL=postgres://nprojects:dev@127.0.0.1:5432/nprojects?sslmode=disable
# The container connects to the PostgreSQL service on the Compose network:
BACKEND_DATABASE_URL=postgres://nprojects:dev@postgres:5432/nprojects?sslmode=disable
DEV_TOKEN=replace-with-a-random-local-development-token
BACKEND_BIND=127.0.0.1
BACKEND_PORT=8080
# Wails client connects from the host to this address:
BACKEND_URL=http://127.0.0.1:8080
# In a container localhost points to the container itself. Set a reachable service address.
LLAMA_BASE_URL=http://your-inference-host:8081/v1
LLAMA_MODEL=your-model-id
LLAMA_API_KEY=

# Optional: enable DB integration tests from the host; otherwise they are skipped.
# TEST_DATABASE_URL=postgres://nprojects:dev@127.0.0.1:5432/nprojects?sslmode=disable
